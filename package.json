{
  "name": "tupigcode",
  "version": "1.0.0",
  "description": "AI coding agent modeled after Claude Code's architecture",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tupigcode": "dist/cli/tupigcode.js",
    "llm": "dist/cli/llm.js",
    "claude-local": "dist/cli/claude-local.js",
    "codex-local": "dist/cli/codex-local.js",
    "opencode-local": "dist/cli/opencode-local.js",
    "mlx-local": "dist/cli/mlx-local.js",
    "gameqa": "dist/cli/gameqa.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-gameqa-static.mjs && chmod +x dist/cli/tupigcode.js dist/cli/llm.js dist/cli/claude-local.js dist/cli/codex-local.js dist/cli/opencode-local.js dist/cli/mlx-local.js dist/cli/gameqa.js",
    "gameqa:serve": "tsx src/cli/gameqa.ts serve --tls off",
    "gameqa:agent": "tsx src/cli/gameqa.ts agent",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:tupigcode": "tsx src/cli/tupigcode.ts",
    "dev:llm": "tsx src/cli/llm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "glob": "^11.0.2",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  }
}
